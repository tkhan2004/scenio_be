// ─────────────────────────────────────────────────────────────────────────────
// Scenio — Prisma Schema
// Database: PostgreSQL
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password              String? // null nếu đăng nhập Google OAuth
  googleId              String?   @unique // null nếu đăng nhập email
  displayName           String?
  avatarUrl             String?
  level                 Level     @default(A2)
  learningGoal          String?
  studyFrequency        String?
  selfAssessment        String?
  needsLevelTest        Boolean   @default(true)
  levelTestedAt         DateTime?
  onboardingCompletedAt DateTime?
  totalXp               Int       @default(0)
  streakDays            Int       @default(0)
  lastActiveDate        DateTime? @db.Date // DATE thay vì timestamp để tính streak dễ hơn
  isAdmin               Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions              Session[]
  customPracticeConfigs CustomPracticeConfig[]
  learningPlans         LearningPlan[]
  userMissions          UserMission[]
  userBadges            UserBadge[]
  userVocabulary        UserVocabulary[]
  vocabularyOccurrences UserVocabularyOccurrence[]
  refreshTokens         RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCENES
// ─────────────────────────────────────────────────────────────────────────────

model Scene {
  id               String        @id @default(uuid())
  title            String
  category         SceneCategory
  description      String
  missionText      String
  difficulty       Level
  estimatedMinutes Int           @default(5)
  characterName    String
  characterRole    String
  systemPrompt     String        @db.Text
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  vocabulary  SceneVocabulary[]
  sessions    Session[]
  voicePreset SceneVoicePreset?
  embedding   SceneEmbedding?
  planSteps   LearningPlanStep[]

  @@map("scenes")
}

model SceneEmbedding {
  id              String     @id @default(uuid())
  sceneId         String     @unique
  provider        AiProvider
  modelId         String
  outputDimension Int
  embeddingText   String     @db.Text
  embeddingHash   String
  metadata        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([provider, modelId])
  @@map("scene_embeddings")
}

model SceneVocabulary {
  id         String @id @default(uuid())
  sceneId    String
  word       String
  definition String
  example    String
  sortOrder  Int    @default(0)

  scene          Scene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  userVocabulary UserVocabulary[]

  @@index([sceneId])
  @@map("scene_vocabulary")
}

// ─────────────────────────────────────────────────────────────────────────────
// VOICES
// ─────────────────────────────────────────────────────────────────────────────

model VoiceProfile {
  id               String        @id @default(uuid())
  displayName      String
  description      String?
  gender           VoiceGender   @default(NEUTRAL)
  locale           String?
  accent           String?
  provider         VoiceProvider @default(ELEVENLABS)
  providerVoiceId  String?
  realtimeProvider VoiceProvider @default(OPENAI)
  realtimeVoiceId  String?
  styleTags        String[]      @default([])
  sampleText       String?
  sampleUrl        String?
  latencyTier      String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  defaultScenePresets       SceneVoicePreset[]     @relation("DefaultVoicePreset")
  defaultMaleScenePresets   SceneVoicePreset[]     @relation("MaleVoicePreset")
  defaultFemaleScenePresets SceneVoicePreset[]     @relation("FemaleVoicePreset")
  sessions                  Session[]
  customPracticeConfigs     CustomPracticeConfig[]

  @@map("voice_profiles")
}

model SceneVoicePreset {
  id                   String   @id @default(uuid())
  sceneId              String   @unique
  defaultVoiceId       String?
  defaultMaleVoiceId   String?
  defaultFemaleVoiceId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  scene              Scene         @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  defaultVoice       VoiceProfile? @relation("DefaultVoicePreset", fields: [defaultVoiceId], references: [id], onDelete: SetNull)
  defaultMaleVoice   VoiceProfile? @relation("MaleVoicePreset", fields: [defaultMaleVoiceId], references: [id], onDelete: SetNull)
  defaultFemaleVoice VoiceProfile? @relation("FemaleVoicePreset", fields: [defaultFemaleVoiceId], references: [id], onDelete: SetNull)

  @@map("scene_voice_presets")
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSIONS & MESSAGES
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id                     String            @id @default(uuid())
  userId                 String
  sceneId                String?
  customPracticeConfigId String?
  sourceType             SessionSourceType @default(CURATED_SCENE)
  voiceProfileId         String?
  voiceProvider          VoiceProvider?
  voiceSnapshotName      String?
  providerSessionId      String?
  modality               SessionModality   @default(TEXT)
  status                 SessionStatus     @default(ACTIVE)
  grammarScore           Float?
  vocabularyScore        Float?
  naturalnessScore       Float?
  xpEarned               Int               @default(0)
  xpGrantedAt            DateTime?
  hintCount              Int               @default(0) // tổng số lần dùng hint trong session
  startedAt              DateTime          @default(now())
  endedAt                DateTime?

  user                  User                       @relation(fields: [userId], references: [id])
  scene                 Scene?                     @relation(fields: [sceneId], references: [id])
  customPracticeConfig  CustomPracticeConfig?      @relation(fields: [customPracticeConfigId], references: [id], onDelete: SetNull)
  voiceProfile          VoiceProfile?              @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)
  messages              Message[]
  vocabularyOccurrences UserVocabularyOccurrence[]

  @@index([userId])
  @@index([sceneId])
  @@index([customPracticeConfigId])
  @@index([voiceProfileId])
  @@index([userId, status])
  @@map("sessions")
}

model CustomPracticeConfig {
  id                   String      @id @default(uuid())
  userId               String
  practiceGoal         String
  successOutcome       String?
  topicSummary         String
  contextType          String
  location             String?
  conversationChannel  String
  timePressure         String?
  specialConditions    String[]    @default([])
  userRole             String
  userIntent           String?
  userEnglishLevel     Level?
  userPersonaNotes     String?
  aiRole               String
  aiDisplayName        String
  aiRelationshipToUser String?
  aiPrimaryGoal        String?
  aiBehaviorStyle      String?
  aiGenderPresentation VoiceGender @default(NEUTRAL)
  aiVoicePresetId      String?
  aiVoiceTone          String?
  aiSpeechSpeed        String?
  aiAccentPreference   String?
  difficulty           Level       @default(A2)
  conversationLength   String?
  correctionStyle      String?
  hintFrequency        String?
  responseComplexity   String?
  focusSkills          String[]    @default([])
  mustUseVocabulary    String[]    @default([])
  avoidTopics          String[]    @default([])
  customInstructions   String?
  displayTitle         String
  displaySubtitle      String
  missionText          String
  estimatedMinutes     Int         @default(10)
  openingMessage       String      @db.Text
  systemPrompt         String      @db.Text
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiVoicePreset VoiceProfile? @relation(fields: [aiVoicePresetId], references: [id], onDelete: SetNull)
  sessions      Session[]

  @@index([userId])
  @@index([aiVoicePresetId])
  @@map("custom_practice_configs")
}

model Message {
  id              String          @id @default(uuid())
  sessionId       String
  role            MessageRole
  content         String          @db.Text
  turnIndex       Int
  providerEventId String?
  modality        MessageModality @default(TEXT)
  audioStartMs    Int?
  audioEndMs      Int?
  isFinal         Boolean         @default(true)

  // Feedback — tách cột riêng thay vì JSON blob để dễ query & thống kê lỗi
  hasError        Boolean?
  errorType       ErrorType?
  originalPhrase  String?
  suggestion      String?
  explanation     String? // giải thích tiếng Việt, tối đa ~15 từ
  isGood          Boolean?
  feedbackDetails Json?
  isHint          Boolean    @default(false) // true nếu là tin nhắn hint từ AI

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, turnIndex])
  @@index([providerEventId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// MISSIONS
// ─────────────────────────────────────────────────────────────────────────────

model DailyMission {
  id          String      @id @default(uuid())
  title       String
  description String
  missionType MissionType
  targetValue Int // ngưỡng cần đạt (vd: 1 scene, điểm 80, 3 ngày streak)
  xpReward    Int         @default(50)
  isActive    Boolean     @default(true)

  userMissions UserMission[]

  @@map("daily_missions")
}

model UserMission {
  id           String    @id @default(uuid())
  userId       String
  missionId    String
  date         String // "YYYY-MM-DD" dạng String tránh timezone edge case
  currentValue Int       @default(0) // tiến độ hiện tại hướng tới targetValue
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?

  user    User         @relation(fields: [userId], references: [id])
  mission DailyMission @relation(fields: [missionId], references: [id])

  @@unique([userId, missionId, date])
  @@index([userId, date])
  @@map("user_missions")
}

// ─────────────────────────────────────────────────────────────────────────────
// BADGES / ACHIEVEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Badge {
  id             String        @id @default(uuid())
  title          String
  description    String
  iconKey        String // key để Flutter map sang icon widget phía client
  conditionType  ConditionType
  conditionValue Int // ngưỡng đạt được badge
  xpReward       Int           @default(0)
  isActive       Boolean       @default(true)

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId]) // mỗi badge chỉ earn 1 lần
  @@index([userId])
  @@map("user_badges")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER VOCABULARY (Flashcard cá nhân)
// ─────────────────────────────────────────────────────────────────────────────

model UserVocabulary {
  id String @id @default(uuid())

  userId String

  // Dictionary aggregate cho user.
  // Một từ chỉ có một bản ghi tổng hợp trong "My Dictionary",
  // còn mỗi lần gặp lại trong từng session sẽ lưu ở bảng occurrence riêng.
  sceneVocabularyId String?
  normalizedWord    String
  word              String
  definition        String

  sourceSessionId String? // session gần nhất mà user gặp/lưu từ này
  encounterCount  Int       @default(1)
  srsLevel        Int       @default(0)
  nextReviewAt    DateTime?
  isMastered      Boolean   @default(false)
  savedAt         DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  reviewedAt      DateTime?

  user            User                       @relation(fields: [userId], references: [id])
  sceneVocabulary SceneVocabulary?           @relation(fields: [sceneVocabularyId], references: [id])
  occurrences     UserVocabularyOccurrence[]

  @@unique([userId, normalizedWord])
  @@index([userId])
  @@index([userId, isMastered])
  @@index([userId, nextReviewAt])
  @@map("user_vocabulary")
}

model UserVocabularyOccurrence {
  id               String   @id @default(uuid())
  userVocabularyId String
  userId           String
  sessionId        String?
  sampleSentence   String?
  sourceMessageId  String?
  createdAt        DateTime @default(now())

  userVocabulary UserVocabulary @relation(fields: [userVocabularyId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        Session?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userVocabularyId, sessionId])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([userVocabularyId])
  @@map("user_vocabulary_occurrences")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI MODEL CATALOG & FEATURE SETTINGS
// ─────────────────────────────────────────────────────────────────────────────

model AiModelCatalog {
  id               String        @id @default(uuid())
  featureType      AiFeatureType
  provider         AiProvider
  modelId          String
  displayName      String
  description      String?
  inputModalities  String[]      @default([])
  outputType       String
  dimensionOptions Int[]         @default([])
  defaultDimension Int?
  config           Json?
  isActive         Boolean       @default(true)
  isSystem         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  activeSettings AiFeatureSetting[]
  benchmarks     AiModelBenchmark[]

  @@unique([featureType, provider, modelId])
  @@index([featureType, isActive])
  @@map("ai_model_catalog")
}

model AiFeatureSetting {
  id               String        @id @default(uuid())
  featureType      AiFeatureType @unique
  activeModelId    String?
  fallbackModelIds String[]      @default([])
  outputDimension  Int?
  config           Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  activeModel AiModelCatalog? @relation(fields: [activeModelId], references: [id], onDelete: SetNull)

  @@map("ai_feature_settings")
}

model AiModelBenchmark {
  id                 String        @id @default(uuid())
  modelCatalogId     String
  featureType        AiFeatureType
  provider           AiProvider
  providerModelId    String
  sampleText         String        @db.Text
  outputDimension    Int?
  embeddingDimension Int?
  latencyMs          Int
  success            Boolean
  errorMessage       String?
  createdAt          DateTime      @default(now())

  modelCatalog AiModelCatalog @relation(fields: [modelCatalogId], references: [id], onDelete: Cascade)

  @@index([featureType, createdAt])
  @@index([modelCatalogId, createdAt])
  @@map("ai_model_benchmarks")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEARNING PLAN
// ─────────────────────────────────────────────────────────────────────────────

model LearningPlan {
  id             String             @id @default(uuid())
  userId         String
  status         LearningPlanStatus @default(ACTIVE)
  title          String
  summary        String             @db.Text
  level          Level
  learningGoal   String?
  studyFrequency String?
  focusSkill     LearningFocusSkill
  weeklyTarget   Int
  generatedBy    String             @default("RULE")
  sourceSnapshot Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps LearningPlanStep[]

  @@index([userId, status])
  @@map("learning_plans")
}

model LearningPlanStep {
  id             String                 @id @default(uuid())
  planId         String
  sceneId        String?
  type           LearningPlanStepType
  status         LearningPlanStepStatus @default(LOCKED)
  focusSkill     LearningFocusSkill
  title          String
  description    String?
  reason         String?
  sortOrder      Int
  targetCount    Int                    @default(1)
  completedCount Int                    @default(0)
  metadata       Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  plan  LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  scene Scene?       @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([planId, status])
  @@index([sceneId])
  @@map("learning_plan_steps")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Level {
  A1
  A2
  B1
  B2
}

enum SceneCategory {
  WORK
  TRAVEL
  DAILY
  SOCIAL
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SessionModality {
  TEXT
  VOICE
}

enum SessionSourceType {
  CURATED_SCENE
  CUSTOM_PRACTICE
}

enum MessageRole {
  USER
  AI
}

enum MessageModality {
  TEXT
  AUDIO_TRANSCRIPT
}

enum VoiceProvider {
  ELEVENLABS
  OPENAI
}

enum VoiceGender {
  MALE
  FEMALE
  NEUTRAL
}

enum ErrorType {
  GRAMMAR
  NATURALNESS
  VOCABULARY
}

enum MissionType {
  COMPLETE_SCENE // hoàn thành X kịch bản
  ACHIEVE_SCORE // đạt điểm >= X trong 1 session
  MAINTAIN_STREAK // duy trì streak X ngày
  SAVE_VOCABULARY // lưu X từ vựng mới
}

enum ConditionType {
  SCENES_COMPLETED // tổng số scene đã hoàn thành >= conditionValue
  STREAK_DAYS // streak liên tục >= conditionValue ngày
  HIGH_SCORE // đạt điểm >= conditionValue ít nhất 1 lần
  VOCAB_SAVED // tổng từ đã lưu >= conditionValue
  FIRST_SESSION // hoàn thành session đầu tiên (conditionValue = 1)
  PERFECT_SCORE // đạt 100 điểm (conditionValue = 100)
}

enum AiFeatureType {
  EMBEDDING
  ROLEPLAY_LLM
  EVALUATOR_LLM
  REALTIME_VOICE
  TTS
  STT
}

enum AiProvider {
  GOOGLE
  OPENAI
  ANTHROPIC
  ELEVENLABS
}

enum LearningPlanStatus {
  ACTIVE
  ARCHIVED
}

enum LearningPlanStepStatus {
  LOCKED
  NEXT
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum LearningPlanStepType {
  SCENE
  VOCABULARY_REVIEW
  GRAMMAR_PRACTICE
  RETRY_SCENE
  CUSTOM_PRACTICE
}

enum LearningFocusSkill {
  GRAMMAR
  VOCABULARY
  NATURALNESS
  CONFIDENCE
}
