# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/scenio_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Provider: "claude" (recommended) or "openai"
LLM_PROVIDER=claude

# Anthropic Claude (used when LLM_PROVIDER=claude)
CLAUDE_API_KEY=sk-ant-replace-with-your-key

# OpenAI (REQUIRED for embedding regardless of LLM_PROVIDER)
OPENAI_API_KEY=sk-replace-with-your-key

# ─── Chroma Vector DB ─────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=scenio_scenes

# ─── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
