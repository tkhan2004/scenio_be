# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/scenio_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Dùng chuỗi dài ngẫu nhiên khi chạy thật/demo.
JWT_SECRET=change_this_to_a_long_random_string
REFRESH_SECRET=change_this_to_a_long_random_refresh_secret
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# ─── Google OAuth Login ───────────────────────────────────────────────────────
# Lấy tại Google Cloud Console OAuth clients.
# Đây là OAuth Client ID, không phải Gemini API key.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── Free / ưu tiên test trước: Gemini Embedding ─────────────────────────────
# Dùng cho pgvector semantic search/recommend và learning plan.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ─── Free / ưu tiên test trước: ElevenLabs TTS ───────────────────────────────
# Dùng cho voice preview / text-to-speech.
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MALE_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_FEMALE_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TEXT=Hello, this is a quick ElevenLabs voice test from Scenio.
ELEVENLABS_OUTPUT_PATH=tmp/elevenlabs-test.mp3

# ─── Optional trả phí sau: OpenAI ─────────────────────────────────────────────
# Dùng cho realtime voice, STT, TTS fallback, embedding fallback, hoặc LLM fallback.
# Có thể để trống nếu chưa nạp. Các feature OpenAI sẽ tự báo thiếu key khi connect/test.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_FORMAT=mp3
OPENAI_REALTIME_MODEL=gpt-realtime-1.5
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TEMPERATURE=0.6
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_API_URL=https://api.openai.com/v1/realtime/client_secrets

# ─── Optional trả phí sau: Anthropic Claude ──────────────────────────────────
# Nếu chưa có Claude key, đừng connect Claude trong admin AI Models.
LLM_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ─── Legacy Chroma Vector DB ─────────────────────────────────────────────────
# Backend hiện ưu tiên PostgreSQL pgvector. Giữ lại để không phá các script/docs cũ.
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=scenio_scenes
