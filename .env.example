# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/scenio_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
REFRESH_SECRET=change_this_to_a_long_random_refresh_secret_in_production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Provider: "claude" (recommended) or "openai"
LLM_PROVIDER=claude

# Anthropic Claude (used when LLM_PROVIDER=claude)
CLAUDE_API_KEY=sk-ant-replace-with-your-key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI (REQUIRED for embedding regardless of LLM_PROVIDER)
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-4o-mini

# ─── Chroma Vector DB ─────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=scenio_scenes

# ─── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small

# ElevenLabs (optional, for voice testing)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MALE_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_FEMALE_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TEXT=Hello, this is a quick ElevenLabs voice test from Scenio.
ELEVENLABS_OUTPUT_PATH=tmp/elevenlabs-test.mp3
