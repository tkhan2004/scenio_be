{
  "name": "scenio-backend",
  "version": "1.0.0",
  "description": "Scenio — Language Learning App Backend API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.9",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^2.4.3",
    "chromadb": "^1.7.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.28.4",
    "pg": "^8.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@prisma/config": "^7.6.0",
    "@types/bcryptjs": "^2.4.x",
    "@types/cors": "^2.8.x",
    "@types/express": "^4.17.x",
    "@types/jsonwebtoken": "^9.0.x",
    "@types/node": "^20.x.x",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.0.3",
    "prisma": "^7.6.0",
    "ts-node": "^10.9.x",
    "typescript": "^5.x.x"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts,json",
    "exec": "ts-node src/server.ts"
  }
}